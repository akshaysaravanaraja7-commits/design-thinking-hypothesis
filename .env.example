# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Never expose this key in frontend JavaScript.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------
# OPTIONAL CONFIGURATION (Not required to run HYPOTHESIS)
# ------------------------------------------------------------------
# GEMINI_MODEL: Override default Gemini model (defaults to gemini-4-hydrogen)
# GEMINI_MODEL="gemini-4-hydrogen"
#
# SEARCH_PROVIDER: Defaults to native Gemini Google Search grounding ("gemini_grounding").
# Optional future external adapters: "google_cse", "tavily", "brave"
# SEARCH_PROVIDER="gemini_grounding"
# SEARCH_API_KEY=""
# SEARCH_ENGINE_ID=""
#
# DATABASE_URL: Optional PostgreSQL connection string for production deployments.
# Development uses local modular persistence automatically with zero DB setup.
# DATABASE_URL=""
